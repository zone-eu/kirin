{
    "name": "kirin",
    "version": "1.0.0",
    "description": "Clusterable/container-ready MX server built on smtp-server",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "show-config": "NODE_CONFIG_ONLY=true node server.js",
        "test": "mocha \"test/**/*.js\"",
        "typecheck": "tsc -p tsconfig.json",
        "check": "npm run typecheck && npm test",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "keywords": [
        "smtp",
        "mail server",
        "mx",
        "inbound"
    ],
    "author": {
        "name": "NickOvt"
    },
    "license": "EUPL-1.2",
    "dependencies": {
        "@zone-eu/mailsplit": "5.4.14",
        "@zone-eu/wild-config": "1.7.5",
        "@zone-eu/wild-plugins": "1.0.9",
        "ipaddr.js": "2.4.0",
        "mailparser": "3.9.14",
        "nodemailer": "9.0.3",
        "npmlog": "7.0.1",
        "punycode.js": "2.3.1",
        "smtp-server": "3.19.2"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@types/node": "25.9.1",
        "@zone-eu/types": "^0.1.6",
        "chai": "4.4.1",
        "eslint": "10.7.0",
        "eslint-config-nodemailer": "1.2.0",
        "eslint-config-prettier": "10.1.8",
        "grunt": "1.6.2",
        "grunt-cli": "1.5.0",
        "grunt-eslint": "26.0.0",
        "grunt-mocha-test": "0.13.3",
        "mocha": "10.7.3",
        "pem": "1.14.8",
        "prettier": "3.9.5",
        "typescript": "^7.0.2"
    }
}
